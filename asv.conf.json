{
    "version": 1,

    "project": "scikit-image",
    "project_url": "https://scikit-image.org/",
    "repo": ".",

    "branches": ["main"],
    "dvcs": "git",
    "environment_type": "virtualenv",
    "install_timeout": 1200,
    "show_commit_url": "https://github.com/scikit-image/scikit-image/commit/",

    "build_command": [
        "/bin/bash -c 'cp {conf_dir}/.benchmark-wheels/{commit}/*.whl {build_cache_dir}/'"
    ],

    "pythons": ["3.12"],
    "matrix": {
         "virtualenv": [],
         "numpy": ["2.1"],
         "scipy": ["1.15"],
         "pooch": []
    },

    "env_dir": ".asv/env",
    "results_dir": ".asv/results",
    "html_dir": ".asv/html"
}
